{
  // Markdown lint rules for docs. See https://github.com/DavidAnson/markdownlint
  "config": {
    "default": true,
    // Long lines are fine in prose and tables
    "MD013": false,
    // Allow repeated headings in different sections (e.g. "Context")
    "MD024": { "siblings_only": true },
    // Allow inline HTML such as <br/> in Mermaid labels and tables
    "MD033": false,
    // Tables do not need padded, aligned columns
    "MD060": false,
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "**/node_modules/**", ".github/pull_request_template.md"],
}
