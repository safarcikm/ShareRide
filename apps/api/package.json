{
  "name": "@shareride/api",
  "version": "0.0.0",
  "private": true,
  "description": "The ShareRide API: a TypeScript modular monolith (ADR 0004)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @shareride/db migrate && pnpm --filter @shareride/db seed && node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "e2e:serve": "node --env-file-if-exists=../../.env src/e2e-server.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --exclude \"src/**/*.integration.test.ts\" --exclude \"src/**/*.contract.test.ts\"",
    "test:integration": "vitest run .integration.test",
    "test:contract": "vitest run .contract.test",
    "clean-up": "node --env-file-if-exists=../../.env src/clean-up-cli.ts",
    "expire-bookings": "node --env-file-if-exists=../../.env src/expire-bookings-cli.ts",
    "invite": "node --env-file-if-exists=../../.env src/invite-cli.ts",
    "metrics": "node --env-file-if-exists=../../.env src/metrics-cli.ts",
    "operator": "node --env-file-if-exists=../../.env src/operator-cli.ts",
    "privacy": "node --env-file-if-exists=../../.env src/privacy-cli.ts",
    "sentry:check": "node --env-file-if-exists=../../.env src/sentry-check-cli.ts",
    "email-previews": "node src/email-previews-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@sentry/node": "catalog:",
    "@shareride/contracts": "workspace:*",
    "@shareride/db": "workspace:*",
    "@shareride/domain": "workspace:*",
    "@shareride/i18n": "workspace:*",
    "@shareride/ui": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "6.2.17",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shareride/api-client": "workspace:*",
    "@shareride/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
