{
  "name": "@shareride/api",
  "version": "0.0.0",
  "private": true,
  "description": "The ShareRide API: a TypeScript modular monolith (ADR 0004)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @shareride/db migrate && pnpm --filter @shareride/db seed && node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "e2e:serve": "node --env-file-if-exists=../../.env src/e2e-server.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --exclude \"src/**/*.integration.test.ts\" --exclude \"src/**/*.contract.test.ts\"",
    "test:integration": "vitest run .integration.test",
    "test:contract": "vitest run .contract.test",
    "clean-up": "node --env-file-if-exists=../../.env src/clean-up-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@shareride/contracts": "workspace:*",
    "@shareride/db": "workspace:*",
    "@shareride/domain": "workspace:*",
    "@shareride/i18n": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shareride/api-client": "workspace:*",
    "@shareride/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
