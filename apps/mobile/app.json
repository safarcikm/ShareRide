{
  "expo": {
    "name": "PuffinRide",
    "slug": "puffinride",
    "owner": "puffinride.is",
    "scheme": "puffinride",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/59be70df-a793-46df-9e42-b3a592af7549"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "is.puffinride.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "is.puffinride.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2F6B4F"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PuffinRide opens your photos so you can choose a profile photo.",
          "cameraPermission": "PuffinRide uses the camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2F6B4F"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#EEF3F4",
          "dark": {
            "backgroundColor": "#121A1E"
          }
        }
      ]
    ],
    "locales": {
      "is": "./locales/is.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "59be70df-a793-46df-9e42-b3a592af7549"
      }
    }
  }
}
