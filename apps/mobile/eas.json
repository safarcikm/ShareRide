{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "node": "26.13.1",
      "pnpm": "12.18.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://puffinride.is",
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "node": "26.13.1",
      "pnpm": "12.18.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.puffinride.is",
        "EXPO_PUBLIC_APP_ENV": "staging"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6840158626"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
