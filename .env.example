# Copy to .env for local development. Never commit .env.
# Values here are for local development only.

NODE_ENV=development
# The deployment: local, staging or production. It names the environment in
# error reports. Staging runs with NODE_ENV=production but may seed the
# draft legal documents.
APP_ENV=local
PORT=3000
LOG_LEVEL=info

# The database from infra/docker/compose.yml
DATABASE_URL=postgres://shareride:shareride-local-only@localhost:5432/shareride

# Used by integration tests; they reset this database.
TEST_DATABASE_URL=postgres://shareride:shareride-local-only@localhost:5432/shareride_test

# Keys the hashes of sign-in codes, phone numbers and rate-limit keys. At
# least 32 characters. Production uses its own: openssl rand -base64 32
AUTH_SECRET=local-only-secret-not-for-production-use

# "dev" prints codes in the API terminal. "vonage" sends real SMS and needs
# the account's API key and secret; "46elks", the fallback, needs its own
# (ADR 0023). Staging and production keep keys in the host's secret store;
# never paste them anywhere else.
SMS_PROVIDER=dev
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# The sender name people see: up to 11 letters and digits.
SMS_SENDER=ShareRide
# Kill switch: true stops all SMS (sign-in then says the code was not sent).
SMS_PAUSED=false

# Who takes payments. "test" opens the app's own test payment screen, where no
# money moves; "none" turns paying off. Unset means test, except in
# production (APP_ENV=production, or NODE_ENV=production without APP_ENV),
# where test is refused and the default is none.
PAYMENT_PROVIDER=test

# The notification worker runs inside the API every 5 seconds; "off" stops it
# in this process.
WORKER=on

# Push goes through Expo's push service (ADR 0026). With Expo's "enhanced
# security" on, every push needs this access token from expo.dev; unset
# sends without one. A secret: Render's secret store, never the repository.
# EXPO_ACCESS_TOKEN=

# Who sends email (ADR 0027). "dev" prints each email in the API terminal;
# "mailjet" sends it and needs the account's API key and secret and a sender
# on a domain validated in Mailjet; "none" sends none. Unset means dev,
# except under NODE_ENV=production (staging too), where dev is refused and
# the default is none.
EMAIL_PROVIDER=dev
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=ShareRide
# Where the links in emails lead: the web app's origin.
WEB_APP_URL=http://localhost:8081

# Where meeting point and profile photos are kept (ADRs 0022 and 0033). "folder" keeps them in
# PHOTO_FOLDER (default: shareride-photos in the system's temporary folder)
# and the API serves them; "hetzner" keeps them in the bucket and needs the
# four PHOTO_BUCKET settings; "none" takes and shows no photos. Unset means
# folder, except under NODE_ENV=production (staging too), where a folder is
# refused and the default is none. The keys are secrets: Render's secret
# store, never the repository.
PHOTO_STORAGE=folder
# PHOTO_FOLDER=
# PHOTO_BUCKET_ENDPOINT=https://nbg1.your-objectstorage.com
# PHOTO_BUCKET=
# PHOTO_BUCKET_ACCESS_KEY=
# PHOTO_BUCKET_SECRET_KEY=

# Signing in with Google (ADR 0034). "dev" is our stand-in: a page of the
# API's own with made-up people; "google" needs the web client's ID and
# secret from Google Cloud; "off" hides the button. Unset means dev, except
# under NODE_ENV=production (staging too), where dev is refused and the
# default is off. The secret belongs in Render's secret store, never here.
GOOGLE_SIGN_IN=dev
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Where browsers reach the API, for Google's and Apple's way back to it.
# Unset means http://localhost:PORT; needed on a server once a provider is on.
# API_ORIGIN=https://staging.skinnar.is

# The operator console's origin, which its passkeys are bound to (ADR 0028).
# Left out locally, it is the API itself (http://localhost:PORT); on a server
# the console's sign-in is off until it is set.
# ADMIN_ORIGIN=http://localhost:3000

# Web app origins allowed to call the API with cookies (Expo web and the
# exported build served for browser tests).
WEB_ORIGINS=http://localhost:8081,http://localhost:8082

# How many proxies in front of the API append to X-Forwarded-For: false
# locally, true behind one load balancer, 2 on Render (Cloudflare, then
# Render's proxy).
TRUST_PROXY=false

# The exported web app, served by the API on its own origin. The container
# image sets it; locally, Expo serves the app instead.
# WEB_APP_DIR=

# Error reports to Sentry's EU region (ADR 0020): the DSN must end in
# .ingest.de.sentry.io. Unset sends nothing. The release is the commit:
# Render sets RENDER_GIT_COMMIT; SENTRY_RELEASE wins. Tracing stays off.
# SENTRY_DSN=
