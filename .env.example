# Copy to .env for local development. Never commit .env.
# Values here are for local development only.

NODE_ENV=development
# The deployment: local, staging or production. Staging runs with
# NODE_ENV=production but may seed the draft legal documents.
APP_ENV=local
PORT=3000
LOG_LEVEL=info

# The database from infra/docker/compose.yml
DATABASE_URL=postgres://shareride:shareride-local-only@localhost:5432/shareride

# Used by integration tests; they reset this database.
TEST_DATABASE_URL=postgres://shareride:shareride-local-only@localhost:5432/shareride_test

# Keys the hashes of sign-in codes, phone numbers and rate-limit keys. At
# least 32 characters. Production uses its own: openssl rand -base64 32
AUTH_SECRET=local-only-secret-not-for-production-use

# "dev" prints codes in the API terminal. "46elks" sends real SMS (ADR 0019)
# and needs the account's API keys; staging and production keep them in the
# host's secret store.
SMS_PROVIDER=dev
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# The sender name people see: up to 11 letters and digits.
SMS_SENDER=ShareRide
# Kill switch: true stops all SMS (sign-in then says the code was not sent).
SMS_PAUSED=false

# Web app origins allowed to call the API with cookies (Expo web and the
# exported build served for browser tests).
WEB_ORIGINS=http://localhost:8081,http://localhost:8082

# How many proxies in front of the API append to X-Forwarded-For: false
# locally, true behind one load balancer, 2 on Render (Cloudflare, then
# Render's proxy).
TRUST_PROXY=false

# The exported web app, served by the API on its own origin. The container
# image sets it; locally, Expo serves the app instead.
# WEB_APP_DIR=
